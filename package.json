{
  "name": "stolpersteine-putzen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.ts",
    "vendor": "node scripts/vendor.ts",
    "dev": "npm run vendor && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply stolpersteine-putzen --local",
    "db:migrate:remote": "wrangler d1 migrations apply stolpersteine-putzen --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run vendor && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^26.6.5",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^2.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
