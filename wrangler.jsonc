{
  "name": "stolpersteine-putzen",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stolpersteine-putzen",
      "database_id": "0ebaf620-e637-4259-9abc-3b4ec8d59bb2",
      "migrations_dir": "migrations"
    }
  ]
}
